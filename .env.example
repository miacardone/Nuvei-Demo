# Copy to .env.local and fill in. .env.local is gitignored.
#
# This repository is PUBLIC — never put a real password in tracked source.

# Username for the demo console. Not secret.
DEMO_USERNAME=NuveiDemo

# Password for the demo console. Required — sign-in is refused if unset.
DEMO_PASSWORD=

# Secret used to sign the session cookie. Set a long random value for any
# deployment reachable by anyone other than you.
AUTH_SECRET=

# Chameleon: show the brand picker in the console chrome. Off by default so a
# client demo shows one brand. Set to "on" to demo a live re-skin.
NEXT_PUBLIC_BRAND_SWITCHER=
